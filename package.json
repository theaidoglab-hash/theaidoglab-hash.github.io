{
  "name": "aidog-public-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run lint && npm run validate:css && npm run typecheck && npm run validate:discoverability && npm run validate:examples && npm run validate:example-runtimes && npm run validate:reader-starters && npm run validate:portfolio-planner && npm run validate:learning-planner && npm run validate:proof-pack && npm run validate:flagship-portfolio && npm run validate:portfolio-evidence-handoff && npm run validate:workforce-starter-pack && npm run validate:renewal-triage-starter && npm run validate:policy-pilot-starter && npm run validate:approval-queue-starter && npm run validate:no-code-starter-lab && npm run validate:ai-app-course && npm run validate:no-code-starter-pack && npm run validate:coding-starter-lab && npm run validate:interview-rehearsal && npm run validate:interview-voice && npm run validate:interview-ledger && npm run validate:article-outline && npm run validate:article-learning-contract && npm run validate:public-voice && npm run validate:audience-scope && npm run validate:claim-boundaries && npm run validate:internal-links && npm run validate:waitlist && npm run validate:turnstile && npm run validate:support && npm run validate:release-scope && npm run validate:release-runtime-scope && npm run validate:release-content-selection && npm run validate:release-learning-selection && npm run validate:release-route-surfaces && npm run validate:release-catalog && npm run validate:release-live-catalog-contract && npm run validate:release-assets && npm run validate:release-build-public-dir && npm run validate:release-gate && npm run validate:csp && npm run validate && vinext build && npm run validate:client-weight && npm run validate:worker-config",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "validate:css": "node scripts/validate-css-syntax.mjs",
    "typecheck": "tsc --noEmit",
    "validate:discoverability": "node scripts/validate-discoverability-contract.mjs && node --experimental-strip-types scripts/validate-resource-search.mjs && npm run validate:build-lab-selection-url",
    "validate:build-lab-selection-url": "node --experimental-strip-types scripts/validate-build-lab-selection-url.mjs",
    "validate": "node scripts/validate-content.mjs",
    "validate:examples": "node scripts/validate-portfolio-examples.mjs",
    "validate:example-runtimes": "node scripts/validate-portfolio-example-runtimes.mjs",
    "validate:reader-starters": "node scripts/validate-reader-starter-packs.mjs",
    "validate:portfolio-planner": "node scripts/validate-portfolio-planner-copy.mjs",
    "validate:proof-pack": "node scripts/validate-portfolio-proof-pack.mjs",
    "validate:flagship-portfolio": "node scripts/validate-flagship-portfolio-architecture.mjs",
    "validate:portfolio-evidence-handoff": "node scripts/validate-portfolio-evidence-handoff-pack.mjs",
    "validate:workforce-starter-pack": "node scripts/validate-workforce-starter-pack.mjs",
    "validate:renewal-triage-starter": "node scripts/validate-renewal-triage-starter.mjs",
    "validate:policy-pilot-starter": "node scripts/validate-policy-pilot-starter.mjs",
    "validate:approval-queue-starter": "node scripts/validate-approval-queue-starter.mjs",
    "validate:learning-planner": "node scripts/validate-learning-evidence-planner.mjs",
    "validate:no-code-starter-lab": "node --experimental-strip-types scripts/validate-no-code-personal-case-builder.mjs && node scripts/validate-no-code-starter-lab.mjs",
    "validate:ai-app-course": "node scripts/validate-ai-app-course.mjs",
    "validate:no-code-starter-pack": "node scripts/validate-no-code-starter-pack.mjs",
    "validate:coding-starter-lab": "node scripts/validate-coding-starter-lab.mjs",
    "validate:interview-rehearsal": "node scripts/validate-interview-rehearsal.mjs",
    "validate:interview-voice": "node scripts/check-interview-voice.mjs",
    "validate:interview-ledger": "node scripts/validate-interview-coverage-ledger.mjs",
    "validate:article-outline": "node --experimental-strip-types scripts/validate-article-outline.mjs",
    "validate:article-learning-contract": "node --experimental-strip-types scripts/validate-article-learning-contract.mjs",
    "validate:internal-links": "node scripts/validate-internal-content-links.mjs",
    "validate:public-voice": "node scripts/validate-public-voice.mjs",
    "validate:audience-scope": "node scripts/validate-global-audience-scope.mjs",
    "validate:claim-boundaries": "node scripts/validate-claim-boundaries.mjs",
    "validate:waitlist": "node scripts/validate-waitlist-contract.mjs",
    "validate:turnstile": "node scripts/validate-turnstile-handoff.mjs",
    "validate:support": "node scripts/validate-support-contract.mjs",
    "validate:release-scope": "node --experimental-strip-types scripts/validate-release-scope-contract.mjs",
    "validate:release-runtime-scope": "node --experimental-strip-types scripts/validate-release-runtime-scope.mjs",
    "validate:release-content-selection": "node --experimental-strip-types scripts/validate-release-content-selection.mjs",
    "validate:release-learning-selection": "node --experimental-strip-types scripts/validate-release-learning-selection.mjs",
    "validate:release-route-surfaces": "node scripts/validate-release-route-surfaces.mjs",
    "validate:release-catalog": "node --experimental-strip-types scripts/validate-release-catalog.mjs",
    "validate:release-live-catalog-contract": "node --experimental-strip-types scripts/validate-live-release-catalog-contract.mjs",
    "validate:release-live-catalog": "node --experimental-strip-types scripts/validate-live-release-catalog.mjs",
    "validate:release-assets": "node --experimental-strip-types scripts/validate-release-static-asset-stager.mjs",
    "validate:release-build-public-dir": "node --experimental-strip-types scripts/validate-release-build-public-dir.mjs",
    "validate:release-gate": "node --experimental-strip-types scripts/validate-release-gate-contract.mjs",
    "validate:csp": "node --experimental-strip-types scripts/validate-csp-contract.mjs",
    "validate:worker-config": "node scripts/validate-built-worker-config.mjs",
    "validate:client-weight": "node scripts/validate-client-weight.mjs",
    "validate:sources": "node scripts/check-sources.mjs",
    "release:check": "node --experimental-strip-types scripts/release-gate.mjs",
    "stage:release-assets": "node --experimental-strip-types scripts/stage-release-static-assets.mjs",
    "build:release": "npm run release:check && npm run validate:sources && npm run build",
    "build:github-pages": "node scripts/build-github-pages.mjs",
    "build:github-pages:preview": "node scripts/build-github-pages.mjs --preview",
    "build:github-pages:release": "node scripts/build-github-pages.mjs --release",
    "deploy": "npm run build:release && wrangler deploy"
  },
  "dependencies": {
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@cloudflare/workers-types": "^5.20260828.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  }
}
