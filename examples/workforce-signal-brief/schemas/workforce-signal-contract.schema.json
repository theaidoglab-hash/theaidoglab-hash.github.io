{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workforce Signal Brief local result",
  "oneOf": [
    { "$ref": "#/$defs/readyResult" },
    { "$ref": "#/$defs/rejectedResult" }
  ],
  "$defs": {
    "action": {
      "type": "object",
      "required": ["kind", "mode", "status", "allowedActions", "prohibitedActions", "requiresHumanReview"],
      "properties": {
        "kind": { "const": "none" },
        "mode": { "const": "evidence_only" },
        "status": { "const": "not_executed" },
        "allowedActions": { "type": "array", "maxItems": 0 },
        "prohibitedActions": { "type": "array", "minItems": 1 },
        "requiresHumanReview": { "const": true }
      }
    },
    "readyResult": {
      "type": "object",
      "required": ["status", "reasonCode", "packet", "action", "trace"],
      "properties": {
        "status": { "const": "CONTEXT_BRIEF_READY" },
        "reasonCode": { "const": "SOURCE_SHAPED_CONTEXT_PACKET" },
        "packet": { "type": "object", "required": ["fixtureId", "seriesFacts", "interpretationBoundaries"] },
        "action": { "$ref": "#/$defs/action" },
        "trace": { "type": "object", "required": ["rawInputRetained", "externalActionExecuted"] }
      }
    },
    "rejectedResult": {
      "type": "object",
      "required": ["status", "reasonCode", "rejectionMessage", "action", "trace"],
      "properties": {
        "status": { "const": "SOURCE_REJECTED" },
        "reasonCode": { "type": "string" },
        "rejectionMessage": { "type": "string" },
        "action": { "$ref": "#/$defs/action" },
        "trace": { "type": "object", "required": ["rawInputRetained", "externalActionExecuted"] }
      }
    }
  }
}
